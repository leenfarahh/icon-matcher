# Template for .env (copy this file to .env and fill in your key). Safe to share: no secrets.
# Loaded by app/config.py; real environment variables win.

# Claude API key for concept extraction. Paste it after the "=".
# Leave empty to use offline keyword matching (rougher picks, no cost).
ANTHROPIC_API_KEY=

# Model for concept extraction. Default (app/config.py): claude-sonnet-4-5, which retires on 30/11/2026.
# Moving to a newer model also needs a parsing change in app/concepts.py: run /claude-api migrate.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Icon library folder (icons.json + the SVGs).
ICON_LIBRARY_DIR=./icons

# Where uploaded decks and generated copies are saved.
ICON_WORK_DIR=./jobs
