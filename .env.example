# Template for .env (copy this file to .env and fill in your key). Safe to share: no secrets.
# Loaded by app/config.py; real environment variables win.

# Claude API key for concept extraction. Paste it after the "=".
# Leave empty to use offline keyword matching (rougher picks, no cost).
ANTHROPIC_API_KEY=

# Model that picks the icons. Default (app/config.py): claude-sonnet-5-5. Requests ask the Claude API to retry a
# declined request on another model (server-side fallback), so another model must accept that too.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# How much Claude thinks before it picks: low (default), medium, high, xhigh or max. Higher costs more and is slower.
# ANTHROPIC_EFFORT=low

# Icon library folder (icons.json + the SVGs).
ICON_LIBRARY_DIR=./icons

# Where uploaded decks and generated copies are saved.
ICON_WORK_DIR=./jobs

# --- Claude connector (app/connector.py). Setup and hosting: app/connector-setup.md ---
# The address Claude reaches the connector at, no trailing slash. The MCP endpoint is this plus /mcp.
# ICON_PUBLIC_URL=http://127.0.0.1:8001

# Sign-in: entra (each designer signs in with Microsoft 365), token (one shared bearer token) or none (this
# machine only). Left empty: entra when ENTRA_TENANT_ID is set, else token when ICON_MCP_TOKEN is set, else none.
# ICON_AUTH=

# Entra ID: the Directory (tenant) ID and the connector app registration's Application (client) ID, both GUIDs.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_SCOPE=access_as_user

# Token mode: at least 32 characters. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ICON_MCP_TOKEN=

# A run's uploaded deck, its copy and its private link are deleted after this many hours.
# ICON_RUN_TTL_HOURS=24
# ICON_MAX_DECK_MB=150
# Decks processed at the same time; the rest wait their turn.
# ICON_PARALLEL_RUNS=2
